parameters:
    level: 8
    paths:
        - src
        - tests
        - one_record.install
        - one_record.module
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Drupal's Form API passes untyped render arrays.
        -
            identifier: missingType.iterableValue
            path: src/Form/*
    reportUnmatchedIgnoredErrors: true
